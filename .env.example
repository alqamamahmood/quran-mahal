# ---- Supabase (required for real data; app runs in sample mode without it) ----
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Service-role key — SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Quran text API (verified source; default works without a key) ----
# api.alquran.cloud serves Tanzil-based Uthmani text + translations.
QURAN_API_BASE=https://api.alquran.cloud/v1

# ---- Payments (Stripe) — OPTIONAL. Without these, the app stays fully usable in free mode. ----
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- Storage buckets (create in Supabase Dashboard → Storage) ----
# media-public   (public read: thumbnails, covers)
# media-private  (private: premium media, served via signed URLs)
# documents      (public or private per book license)
